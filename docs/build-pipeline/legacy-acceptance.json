  "edgeCases": [
    {"id":"shellcode-windows-arm64","target":"windows/arm64","mode":"session","format":"shellcode","expected":"client-reject","reason":"Windows shellcode parser allows only 386 and amd64"},
    {"id":"shellcode-darwin-amd64","target":"darwin/amd64","mode":"session","format":"shellcode","expected":"client-reject","reason":"Darwin shellcode parser allows only arm64"},
    {"id":"shellcode-linux-386","target":"linux/386","mode":"session","format":"shellcode","expected":"client-reject","reason":"Linux shellcode parser allows only amd64 and arm64"},
    {"id":"named-pipe-linux","target":"linux/amd64","mode":"session","format":"exe","protocol":"named-pipe","expected":"client-reject","reason":"Named pipe pivoting is Windows-only"},
    {"id":"no-c2","target":"windows/amd64","mode":"session","format":"exe","protocol":"none","expected":"client-reject","reason":"At least one parsed C2 URL is required"},
    {"id":"unknown-format","target":"windows/amd64","mode":"session","format":"unknown-format","expected":"legacy-fallback-exe","reason":"The current client silently maps an unknown format to EXECUTABLE; M2 changes this"},
    {"id":"service-nonwindows","target":"linux/amd64","mode":"session","format":"service","expected":"not-advertised-legacy-rpc-route","reason":"GetCompilerTargets only advertises Windows service, but the legacy RPC switch uses SliverExecutable without enforcing the OS"},
    {"id":"darwin-host-linux-386-cgo","target":"linux/386","mode":"session","format":"shared","host":"darwin","expected":"not-advertised-even-with-cross-compiler","reason":"GetCompilerTargets explicitly skips Linux/386 CGO outputs on Darwin hosts"},
    {"id":"beacon-named-pipe","target":"windows/amd64","mode":"beacon","format":"exe","protocol":"named-pipe","expected":"client-accepts-runtime-unsupported","reason":"The parser accepts it; the beacon transport has no namedpipe handler"},
    {"id":"beacon-tcp-pivot","target":"linux/amd64","mode":"beacon","format":"exe","protocol":"tcp-pivot","expected":"client-accepts-runtime-unsupported","reason":"The parser accepts it; the beacon transport has no tcppivot handler"}
