#!/bin/sh
set -e

SLIVER_MINISIGN_PUB_KEY="RWTZPg959v3b7tLG7VzKHRB1/QT+d3c71Uzetfa44qAoX5rH7mGoQTTR"
SLIVER_PLATFORM="linux"

if [ "$(id -u)" -ne 0 ]; then
    echo "Please run as root"
    exit 1
fi

# Only include minisign in the package list when it isn't already on PATH.
# The minisign apt package isn't in the default Ubuntu 22.04 repos, but
# users often install it manually to /usr/local/bin first; without this
# guard the apt-get call below fails the whole script (issue #2239).
MINISIGN_PKG="minisign"
if command -v minisign > /dev/null 2>&1; then
    MINISIGN_PKG=""
fi

# Detect Alpine from OS identity, not merely from an apk executable that may
# also be installed on another distribution.
IS_ALPINE=false
if test -r /etc/os-release; then
    if grep -Eq '^ID="?alpine"?$' /etc/os-release; then
        IS_ALPINE=true
    fi
elif test -f /etc/alpine-release; then
    IS_ALPINE=true
fi

# Determine the package manager. Alpine identity takes precedence so a host
# with multiple package-management tools cannot select mismatched init logic.
if [ "$IS_ALPINE" = true ]; then
    if ! command -v apk > /dev/null 2>&1; then
        echo "Alpine Linux detected, but apk could not be found"
        exit 1
    fi
    PACKAGE_MANAGER="apk"
elif command -v apt-get > /dev/null 2>&1; then
    PACKAGE_MANAGER="apt"
elif command -v yum > /dev/null 2>&1; then
    PACKAGE_MANAGER="yum"
elif command -v pacman > /dev/null 2>&1; then
    PACKAGE_MANAGER="pacman"
else
    echo "Unsupported OS, exiting"
    exit 1
fi

install_packages() {
    case "$PACKAGE_MANAGER" in
        apt)
            DEBIAN_FRONTEND=noninteractive apt-get install -yqq "$@"
            ;;
        yum)
            yum -y install "$@"
            ;;
        pacman)
            pacman --noconfirm -S "$@"
            ;;
        apk)
            apk add --no-cache "$@"
            ;;
    esac
}

case "$PACKAGE_MANAGER" in
    apt)
        echo "Installing dependencies using apt..."
        if [ -n "$MINISIGN_PKG" ]; then
            install_packages "$MINISIGN_PKG" curl build-essential git
        else
            install_packages curl build-essential git
        fi
        ;;
    yum)
        echo "Installing dependencies using yum..."
        if [ -n "$MINISIGN_PKG" ]; then
            install_packages "$MINISIGN_PKG" curl make git
        else
            install_packages curl make git
        fi
        ;;
    pacman)
        echo "Installing dependencies using pacman..."
        if [ -n "$MINISIGN_PKG" ]; then
            install_packages "$MINISIGN_PKG"
        fi
        ;;
    apk)
        echo "Installing dependencies using apk..."
        if [ -n "$MINISIGN_PKG" ]; then
            install_packages "$MINISIGN_PKG" curl git make build-base
        else
            install_packages curl git make build-base
        fi
        ;;
esac

# Verify if necessary tools are installed
for cmd in curl awk minisign; do
    if ! command -v "$cmd" > /dev/null 2>&1; then
        echo "$cmd could not be found, installing..."
        install_packages "$cmd"
    fi
done

# Select the service manager independently from the distribution and package
# manager. Containers commonly have neither init system running.
SERVICE_MANAGER="none"
if command -v systemctl > /dev/null 2>&1 && test -d /run/systemd/system; then
    SERVICE_MANAGER="systemd"
elif command -v rc-service > /dev/null 2>&1 && \
    command -v rc-update > /dev/null 2>&1 && \
    command -v openrc-run > /dev/null 2>&1 && \
    command -v supervise-daemon > /dev/null 2>&1 && \
    test -e /run/openrc/softlevel; then
    SERVICE_MANAGER="openrc"
fi

if [ "$SERVICE_MANAGER" = "none" ]; then
    echo "No running systemd or OpenRC instance detected."
    echo "Sliver will be installed without a system service."
fi

cd /root || exit
echo "Running from $(pwd)"

echo "Using Minisign public key..."

find_existing_sliver_server() {
    if test -x /root/sliver-server; then
        echo /root/sliver-server
    elif command -v sliver-server > /dev/null 2>&1; then
        command -v sliver-server
    fi
}

ensure_unmanaged_upgrade_is_safe() {
    if [ "$SERVICE_MANAGER" != "none" ]; then
        return 0
    fi

    existing_sliver_server="$(find_existing_sliver_server)"
    if [ -n "$existing_sliver_server" ] && \
        pgrep -f "${existing_sliver_server} daemon" > /dev/null 2>&1; then
        echo "Sliver is running without an active systemd/OpenRC manager." >&2
        echo "Stop it with the container or process supervisor, then rerun." >&2
        return 1
    fi
}

stop_existing_sliver_daemon() {
    existing_sliver_server="$(find_existing_sliver_server)"

    if [ -z "$existing_sliver_server" ]; then
        return 0
    fi

    echo "Existing Sliver server install detected at $existing_sliver_server"

    case "$SERVICE_MANAGER" in
        openrc)
            if test -f /etc/init.d/sliver; then
                echo "Stopping the Sliver OpenRC service before upgrade..."
                rc-service sliver stop
            fi
            ;;
        systemd)
            if test -f /etc/systemd/system/sliver.service && \
                systemctl is-active --quiet sliver; then
                echo "Stopping the Sliver systemd service before upgrade..."
                systemctl stop sliver
            fi
            ;;
        none)
            if pgrep -f "${existing_sliver_server} daemon" > /dev/null 2>&1; then
                echo "Sliver is running without an active systemd/OpenRC manager." >&2
                echo "Stop it with the container or process supervisor, then rerun." >&2
                return 1
            fi
            ;;
    esac

    if [ "$SERVICE_MANAGER" != "none" ] && \
        pgrep -f "${existing_sliver_server} daemon" > /dev/null 2>&1; then
        echo "Stopping the remaining Sliver daemon before upgrade..."
        pkill -f "${existing_sliver_server} daemon"
    fi
}

ensure_unmanaged_upgrade_is_safe

# Download and Unpack Sliver Server
ARCH="$(uname -m)"
case "$ARCH" in
    x86_64|amd64)
        SLIVER_PLATFORM="linux-amd64"
        ;;
    aarch64|arm64)
        SLIVER_PLATFORM="linux-arm64"
        ;;
    *)
        echo "Unsupported architecture: $ARCH"
        exit 1
        ;;
esac

echo "Fetching latest Sliver release URLs..."
ARTIFACTS=$(curl -s "https://api.github.com/repos/BishopFox/sliver/releases/latest" | awk -F '"' '/browser_download_url/{print $4}')
SLIVER_SERVER="sliver-server_${SLIVER_PLATFORM}"
SLIVER_CLIENT="sliver-client_${SLIVER_PLATFORM}"

for URL in $ARTIFACTS; do
    case "$URL" in
        *"$SLIVER_SERVER"*)
            echo "Downloading $URL"
            curl --silent -L "$URL" --output "$(basename "$URL")"
            ;;
    esac
    case "$URL" in
        *"$SLIVER_CLIENT"*)
            echo "Downloading $URL"
            curl --silent -L "$URL" --output "$(basename "$URL")"
            ;;
    esac
done

# Signature verification
echo "Verifying signatures ..."
minisign -Vm "/root/$SLIVER_SERVER" -x "/root/$SLIVER_SERVER.minisig" -P "$SLIVER_MINISIGN_PUB_KEY"
minisign -Vm "/root/$SLIVER_CLIENT" -x "/root/$SLIVER_CLIENT.minisig" -P "$SLIVER_MINISIGN_PUB_KEY"

stop_existing_sliver_daemon

if test -f "/root/$SLIVER_SERVER"; then
    echo "Moving the Sliver server executable to /root/sliver-server..."
    mv "/root/$SLIVER_SERVER" /root/sliver-server

    echo "Setting permissions for the Sliver server executable..."
    chmod 755 /root/sliver-server

    echo "Unpacking the Sliver server..."
    /root/sliver-server unpack --force
else
    exit 3
fi

if test -f "/root/$SLIVER_CLIENT"; then
    echo "Setting permissions for the Sliver client executable..."
    chmod 755 "/root/$SLIVER_CLIENT"

    echo "Copying the Sliver client executable to /usr/local/bin/sliver-client..."
    cp -vv "/root/$SLIVER_CLIENT" /usr/local/bin/sliver-client

    echo "Creating a symbolic link for sliver-client at /usr/local/bin/sliver..."
    ln -sf /usr/local/bin/sliver-client /usr/local/bin/sliver

    echo "Setting permissions for the symbolic link /usr/local/bin/sliver..."
    chmod 755 /usr/local/bin/sliver
else
    exit 3
fi

case "$SERVICE_MANAGER" in
    openrc)
        echo "Configuring OpenRC service ..."
        install -o root -g root -m 0755 /dev/stdin /etc/init.d/sliver <<'EOF'
#!/sbin/openrc-run
name="sliver"
description="Sliver server"
command="/root/sliver-server"
command_args="daemon"
supervisor=supervise-daemon
pidfile="/run/sliver.pid"
respawn_delay=3
respawn_max=0

depend() {
    after net
}
EOF
        ;;
    systemd)
        echo "Configuring systemd service ..."
        install -o root -g root -m 0600 /dev/stdin /etc/systemd/system/sliver.service <<'EOF'
[Unit]
Description=Sliver
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=on-failure
RestartSec=3
User=root
ExecStart=/root/sliver-server daemon

[Install]
WantedBy=multi-user.target
EOF
        ;;
esac

# Generate local configs
echo "Generating local configs ..."

# Generate local configs
echo "Generating operator configs ..."
mkdir -p /root/.sliver-client/configs
/root/sliver-server operator --name root --lhost 127.0.0.1 --permissions all --save /root/.sliver-client/configs
chown -R root:root /root/.sliver-client/

for USER_DIR in /home/*; do
    test -d "$USER_DIR" || continue
    USER=$(basename "$USER_DIR")
    if id -u "$USER" >/dev/null 2>&1; then
        echo "Generating operator configs for user $USER..."
        mkdir -p "$USER_DIR/.sliver-client/configs"
        /root/sliver-server operator --name "$USER" --lhost 127.0.0.1 --permissions all --save "$USER_DIR/.sliver-client/configs"
        chown -R "$USER":"$(id -gn "$USER")" "$USER_DIR/.sliver-client/"
    fi
done

case "$SERVICE_MANAGER" in
    openrc)
        echo "Enabling and starting the Sliver OpenRC service..."
        rc-update add sliver default
        rc-service sliver start
        ;;
    systemd)
        echo "Reloading systemd and starting the Sliver service..."
        systemctl daemon-reload
        systemctl start sliver
        ;;
    none)
        echo "Installation complete. Start the server as the supervised foreground process:"
        echo "  exec /root/sliver-server daemon"
        ;;
esac
